v##############################
# Application
##############################
NODE_ENV=development
PORT=6001

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_TIMEFRAME=3d

##############################
# Database
##############################
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=noorai
DB_ENTITIES=dist/modules/**/*.model{.ts,.js}
DB_MIGRATIONS=dist/database/migrations/*{.ts,.js}
DB_SSL=false

##############################
# Redis / Bull Queue
##############################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=your_redis_url
##############################
# Auth / JWT
##############################
# Generate a secure JWT secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_secure_random_string
JWT_TIMEFRAME=6M

##############################
# OAuth Multi-Platform Configuration
##############################
# Google OAuth Client IDs for different platforms
# Web: Create OAuth 2.0 client ID for web application
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Android: Create OAuth 2.0 client ID for Android application
ANDRIOD_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# Apple: Create Sign in with Apple service ID
APPLE_CLIENT_ID=your-apple-service-id

##############################
# SMTP Transport (primary)
##############################
MAIL_MAILER=smtp
MAIL_ENCRYPTION=TLS
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM="DeenAI <no-reply@deenai.com>"

##############################
# Alternate MAIL_* variable names (optional)
##############################
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM_NAME=DeenAI
MAIL_FROM_ADDRESS=no-reply@deenai.com

##############################
# AI KEY
##############################

GEMINI_API_KEY=

UPLOAD_DIR=uploads
PROFILE_IMAGE_STORAGE_PATH=uploads/profiles
PROFILE_IMAGE_MAX_SIZE=5000000
PROFILE_IMAGE_MAX_WIDTH=2000
PROFILE_IMAGE_MAX_HEIGHT=2000

SERVER_URL=http://localhost:6001


##############################
# GOOGLE CRED
##############################

GOOGLE_PROJECT_ID=google-project-id
GOOGLE_LOCATION=location
GOOGLE_MODEL_ENDPOINT_ID=GOOGLE_MODEL_ENDPOINT_ID

RECITER_AUDIO_STORAGE_PATH=uploads/reciters
RECITER_AUDIO_MAX_SIZE=52428800  # 50MB
