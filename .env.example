v##############################
# Application
##############################
NODE_ENV=development
PORT=6001

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_TIMEFRAME=3d

##############################
# Database
##############################
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=noorai
DB_ENTITIES=dist/modules/**/*.model{.ts,.js}
DB_MIGRATIONS=dist/database/migrations/*{.ts,.js}
DB_SSL=false

##############################
# Redis / Bull Queue
##############################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=your_redis_url
##############################
# Auth / JWT
##############################
JWT_SECRET=change_me
JWT_TIMEFRAME=3d
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

##############################
# SMTP Transport (primary)
##############################
MAIL_MAILER=smtp
MAIL_ENCRYPTION=TLS
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM="DeenAI <no-reply@deenai.com>"

##############################
# Alternate MAIL_* variable names (optional)
##############################
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM_NAME=DeenAI
MAIL_FROM_ADDRESS=no-reply@deenai.com

##############################
# AI KEY
##############################

GEMINI_API_KEY=